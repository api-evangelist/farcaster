  "info": {
    "_postman_id": "04f17217-a253-4c52-b2df-9c516cffefaa",
    "name": "Farcaster Snapchain Hub HTTP Casts Links API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "HTTP query interface for Farcaster's Snapchain network. Read casts, reactions, follows, user data, verifications and on-chain events by FID; submit signed protobuf messages; and stream hub events. The public reference endpoint is hosted at https://snapchain.farcaster.xyz, but operators typically run their own Snapchain node and bind the HTTP server to a local port (default 3381).\n\nContact Support:\n Name: Farcaster",
      "type": "text/plain"
    }
  }
